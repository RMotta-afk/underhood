{
  "name": "underhood",
  "version": "0.1.0",
  "private": true,
  "description": "Turns code into visual, plain-language representations for non-coders and developers alike.",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:secrets": "bun run scripts/check-secrets.ts",
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "evals": "bun run tests/evals/topology.eval.ts"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.0",
    "eslint": "^10.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0"
  }
}
