{
  "name": "underhood",
  "version": "0.1.0",
  "private": true,
  "description": "Turns code into visual, plain-language representations for non-coders and developers alike.",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.0"
  }
}
