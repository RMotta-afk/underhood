# Underhood environment template.
# Copy to .env and fill in values. NEVER commit .env. Agents never read it.

# --- Model routing (OpenAI-compatible abstraction) ---
MODEL_PROVIDER=openai            # openai | groq
MODEL_ID=gpt-4o                  # any model id valid for MODEL_PROVIDER
MODEL_BASE_URL=                  # optional override (e.g. https://api.groq.com/openai/v1)

# --- Keys (fill in .env only; never commit) ---
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Persistence & queue (pg-boss shares this instance) ---
DATABASE_URL=postgres://postgres:postgres@db:5432/underhood
WORKER_CONCURRENCY=4

# --- Dedup embeddings (entity-aware similar-snippet matching) ---
EMBEDDING_MODEL=text-embedding-3-small
SIMILARITY_THRESHOLD=0.95

# --- Observability (Langfuse Cloud free tier; leave blank to disable tracing) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# --- LLM ---
LLM_TIMEOUT_MS=90000

# --- App ---
PORT=3000
NODE_ENV=development
